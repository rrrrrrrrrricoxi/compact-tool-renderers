{
  "name": "pi-compact-renderer",
  "version": "3.0.0",
  "type": "module",
  "description": "Pi Fold: readable agent transcripts with collapsible work, inspectable details, and clear final replies",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rrrrrrrrrricoxi/compact-tool-renderers.git"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "preview": "node scripts/preview.mjs",
    "preview:work": "node scripts/preview-work-strip.mjs",
    "benchmark": "node --expose-gc scripts/performance-review.mjs",
    "benchmark:memory": "node --expose-gc scripts/retained-memory-review.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "files": [
    "index.ts",
    "src/*.ts",
    "tests/*.mjs",
    "tests/fixtures/*.ts",
    "scripts/*.mjs",
    "docs/*.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "terminal",
    "tui",
    "compact-renderer"
  ],
  "homepage": "https://github.com/rrrrrrrrrricoxi/compact-tool-renderers#readme",
  "bugs": {
    "url": "https://github.com/rrrrrrrrrricoxi/compact-tool-renderers/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
