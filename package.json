{
  "name": "pi-compact-renderer",
  "version": "2.5.2",
  "type": "module",
  "description": "Compact Pi transcripts with collapsible work strips, grouped tool calls, prompt folding, and readable final replies",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rrrrrrrrrricoxi/compact-tool-renderers.git"
  },
  "scripts": {
    "test": "node test.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "files": [
    "*.ts",
    "*.mjs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "IMPLEMENTATION.md",
    "PERFORMANCE.md",
    "renderer/*.mjs",
    "docs/renderer-reference.md"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "terminal",
    "tui",
    "compact-renderer"
  ],
  "homepage": "https://github.com/rrrrrrrrrricoxi/compact-tool-renderers#readme",
  "bugs": {
    "url": "https://github.com/rrrrrrrrrricoxi/compact-tool-renderers/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
